# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# logs generados en runtime por winston (LoggerService crea el directorio)
/logs

# cache del compilador swc
/.swc

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.hermes
/docs
/actas
src/lib/INVENTARIO_REFACTOR_SUMMARY.md
src/app/inventario-pirolisis/README.md
/src/__tests__/api/activos
